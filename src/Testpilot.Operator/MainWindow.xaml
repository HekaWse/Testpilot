<Window
    x:Class="Testpilot.Operator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Testpilot.Operator"
    Title="Testpilot – Prüfung"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    FontSize="16"
    Style="{StaticResource {x:Type Window}}"
    WindowState="Maximized">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding
            Key="Space"
            Command="{Binding ContinueCommand}"
            Modifiers="Control" />
    </Window.InputBindings>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource BrandButton}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource BrandInk}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrandYellow}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9E7EB" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
        </Grid.RowDefinitions>
        <Border Grid.Row="1" IsHitTestVisible="False">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,28,12" ViewportUnits="Absolute"
                              Viewbox="0,0,28,12" ViewboxUnits="Absolute" Stretch="None">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{StaticResource BrandBlue}" Geometry="M0,0 H28 V12 H0 Z" />
                            <GeometryDrawing Brush="{StaticResource BrandYellow}" Geometry="M0,0 H14 L4,12 H0 Z M28,0 L18,12 H28 Z" />
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: station, debug mode, version  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontSize="22"
                FontWeight="Bold">
                <Run Text="Messplatz " /><Run Text="{Binding Station, Mode=OneWay}" />
            </TextBlock>
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Foreground="White"
                Text="{Binding SoftwareVersion, StringFormat=Version {0}}" />
            <Border
                Margin="16,0,0,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{StaticResource BrandPanel}"
                DockPanel.Dock="Right"
                Visibility="{Binding IsAutoStart, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock FontWeight="SemiBold" Text="{Binding FixtureStateText}" />
            </Border>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Border
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrandYellow}"
                    Visibility="{Binding IsDebugMode, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="{StaticResource BrandInk}"
                        Text="{Binding DebugModeText}" />
                </Border>
                <Button
                    Command="{Binding DebugLogoutCommand}"
                    Content="Debugmodus beenden"
                    Visibility="{Binding IsDebugMode, Converter={StaticResource VisibleWhenTrue}}" />
                <Button
                    Command="{Binding DebugLoginCommand}"
                    Content="_Debugmodus …"
                    ToolTip="Debugmodus mit Kürzel und Passwort aktivieren (Einzelschritt)">
                    <Button.Style>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="8"
            Background="DarkOrange"
            Visibility="{Binding Simulated, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="SIMULATION – es werden keine echten Geräte angesprochen, die Ergebnisse sind keine echte Prüfung." />
                <StackPanel
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding CanSimulateFixture, Converter={StaticResource VisibleWhenTrue}}">
                    <Button Command="{Binding SimulateFixtureCloseCommand}" Content="Adapter s_chließen (Simulation)" />
                    <CheckBox
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="Lesefehler des Code-Lesers simulieren"
                        Foreground="White"
                        IsChecked="{Binding SimulateReadFailure}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Order and serial number  -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="_FAUF:"
                Target="{Binding ElementName=FaufBox}" />
            <TextBox
                x:Name="FaufBox"
                Grid.Row="0"
                Grid.Column="1"
                IsEnabled="{Binding CanEdit}"
                Text="{Binding Fauf, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding LoadOrderCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                Command="{Binding LoadOrderCommand}"
                Content="Auftrag _laden" />
            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="3"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{Binding OrderText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding ArticleDescription}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="13"
                    Text="{Binding PlanText}" />
            </StackPanel>

            <Label
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,0,0"
                Content="_Seriennummer:"
                Target="{Binding ElementName=SerialBox}" />
            <TextBox
                x:Name="SerialBox"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,8,0,0"
                IsEnabled="{Binding CanEdit}"
                Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SerialEnteredCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,8,0,0"
                Orientation="Horizontal">
                <Button
                    Command="{Binding StartCommand}"
                    Content="Start (F5)"
                    FontWeight="Bold"
                    Visibility="{Binding IsManualStart, Converter={StaticResource VisibleWhenTrue}}" />
                <Button Command="{Binding CancelCommand}" Content="_Abbrechen (Esc)" />
                <CheckBox
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Content="_Einzelschritt"
                    IsChecked="{Binding SingleStepMode}"
                    IsEnabled="{Binding CanEdit}"
                    Visibility="{Binding IsDebugMode, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
        </Grid>

        <!--  Single-step and operator prompt  -->
        <StackPanel Grid.Row="3">
            <Border
                Margin="0,0,0,8"
                Padding="8"
                Background="{StaticResource BrandPanel}"
                Visibility="{Binding IsWaitingForContinue, Converter={StaticResource VisibleWhenTrue}}">
                <DockPanel>
                    <Button
                        Command="{Binding ContinueCommand}"
                        Content="_Weiter (Strg+Leertaste)"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding ContinueText}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border
                Margin="0,0,0,8"
                Padding="8"
                Background="{StaticResource BrandYellow}"
                TextElement.Foreground="{StaticResource BrandInk}"
                Visibility="{Binding IsPromptVisible, Converter={StaticResource VisibleWhenTrue}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding YesCommand}" Content="_Ja" />
                        <Button Command="{Binding NoCommand}" Content="_Nein" />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{Binding PromptMessage}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!--  Steps  -->
        <DataGrid
            Grid.Row="4"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Steps}"
            SelectionMode="Single"
            Background="{StaticResource BrandPanel}"
            Foreground="{StaticResource BrandInk}"
            BorderBrush="White"
            RowBackground="White"
            AlternatingRowBackground="#E8F7FC"
            HorizontalGridLinesBrush="#AEDDEB">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BrandPanel}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="BorderBrush" Value="#73CEE5" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource BrandInk}" />
                            <Setter Property="BorderBrush" Value="#006B8A" />
                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Message}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandInk}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:StepRowState.Running}">
                            <Setter Property="Background" Value="LightYellow" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:StepRowState.Pass}">
                            <Setter Property="Background" Value="#FFD8F0D8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:StepRowState.Fail}">
                            <Setter Property="Background" Value="#FFF4C7C7" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:StepRowState.Error}">
                            <Setter Property="Background" Value="#FFFFD9A8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:StepRowState.Skipped}">
                            <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Number}"
                    Header="Nr." />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Name}"
                    Header="Schritt" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding TypeText}"
                    Header="Typ" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LowText}"
                    Header="Untergrenze" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ValueText}"
                    FontWeight="Bold"
                    Header="Messwert" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding HighText}"
                    Header="Obergrenze" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding StateText}"
                    FontWeight="Bold"
                    Header="Ergebnis" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Message}"
                    Header="Meldung" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Result, status, errors  -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                MinHeight="90"
                Padding="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrandPanel}" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultState}" Value="{x:Static local:RunDisplayState.Running}">
                                <Setter Property="Background" Value="SteelBlue" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultState}" Value="{x:Static local:RunDisplayState.Pass}">
                                <Setter Property="Background" Value="ForestGreen" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultState}" Value="{x:Static local:RunDisplayState.Fail}">
                                <Setter Property="Background" Value="Firebrick" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultState}" Value="{x:Static local:RunDisplayState.Error}">
                                <Setter Property="Background" Value="DarkOrange" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultState}" Value="{x:Static local:RunDisplayState.Aborted}">
                                <Setter Property="Background" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="40"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding ResultText}" />
            </Border>
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="18"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrandYellow}"
                    Text="{Binding ErrorText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding ExportPath, StringFormat=Export: {0}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</Window>
