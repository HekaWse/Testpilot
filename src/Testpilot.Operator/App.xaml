<Application
    x:Class="Testpilot.Operator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <SolidColorBrush x:Key="BrandBlue" Color="#00A7D1" />
        <SolidColorBrush x:Key="BrandPanel" Color="#007FA5" />
        <SolidColorBrush x:Key="BrandYellow" Color="#FFE000" />
        <SolidColorBrush x:Key="BrandInk" Color="#143340" />
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Arial Narrow, Arial" />
            <Setter Property="Background" Value="{StaticResource BrandBlue}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="BrandButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource BrandPanel}" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#006B8A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#00536B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrandYellow}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="Arial Narrow, Arial" />
            <Setter Property="Foreground" Value="{StaticResource BrandInk}" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Application.Resources>
</Application>
