<Window
    x:Class="Testpilot.Operator.DebugLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Debugmodus aktivieren"
    Width="420"
    FontSize="16"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock
            Margin="0,0,0,12"
            Text="Nur für berechtigte Personen (Editor &gt; Debug-Berechtigungen). Im Debugmodus kann im Einzelschritt geprüft werden."
            TextWrapping="Wrap" />
        <Label Content="_Kürzel:" Foreground="White" Padding="0,0,0,2" Target="{Binding ElementName=ShortNameBox}" />
        <TextBox x:Name="ShortNameBox" Padding="4" />
        <Label Content="_Passwort:" Margin="0,8,0,0" Foreground="White" Padding="0,0,0,2" Target="{Binding ElementName=PasswordBox}" />
        <PasswordBox x:Name="PasswordBox" Padding="4" />
        <TextBlock
            x:Name="ErrorBlock"
            Margin="0,8,0,0"
            FontWeight="Bold"
            Foreground="{StaticResource BrandYellow}"
            TextWrapping="Wrap" />
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="LoginButton"
                MinWidth="110"
                Padding="16,6"
                Click="OnLoginClick"
                Content="Anmelden"
                IsDefault="True"
                Style="{StaticResource BrandButton}" />
            <Button
                MinWidth="110"
                Margin="8,0,0,0"
                Padding="16,6"
                Content="Abbrechen"
                IsCancel="True"
                Style="{StaticResource BrandButton}" />
        </StackPanel>
    </StackPanel>
</Window>
